# ==============================================================================
# Xchange Monorepo — Environment Configuration Template (Phase 0 / v0.0)
# ==============================================================================

# --- Environment ---
NODE_ENV=development
LOG_LEVEL=info

# --- API Service (apps/api) ---
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# --- Database & Redis (infra/docker-compose.yml defaults) ---
DATABASE_URL=postgresql://xchange:xchange_local_dev@localhost:5432/xchange?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth & Security ---
JWT_ACCESS_SECRET=dev-only-jwt-access-secret-replace-in-production-32chars
JWT_REFRESH_SECRET=dev-only-jwt-refresh-secret-replace-in-production-32chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS_PER_HOUR=5
OTP_RESEND_COOLDOWN_SECONDS=30
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Media / Object Storage (R2 or local MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=xchange-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
CDN_PUBLIC_URL=http://localhost:9000/xchange-media

# --- AI & Maps ---
GEMINI_API_KEY=mock-dev-key
MAPS_PROVIDER=mapbox
NEXT_PUBLIC_MAPS_KEY=pk.mock_dev_mapbox_token

# --- Web Application (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/rt
NEXT_PUBLIC_CDN_URL=http://localhost:9000/xchange-media
NEXT_PUBLIC_FEATURE_FLAGS_URL=http://localhost:4000/v1/config
NEXT_PUBLIC_POSTHOG_KEY=phc_mock_local_key
SENTRY_DSN=
